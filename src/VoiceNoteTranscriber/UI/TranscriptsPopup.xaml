<Window x:Class="VoiceNoteTranscriber.UI.TranscriptsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Note Transcriber"
        ThemeMode="Dark"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Background="#141414"
        MinWidth="320" MinHeight="300"
        Height="560"
        Width="440">
    <!-- Our own slim title bar (the top 28 px act as Windows' caption: drag,
         double-click to maximize, snapping), with the native resize borders. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC0000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource CloseButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small text buttons: Copy on a card, Copy all / Clear in the footer. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#60CDFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="#404040" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&#xE8E5;" FontSize="13" Style="{StaticResource TitleButton}"
                            Click="OnOpenClick" ToolTip="Open voice notes…" />
                    <Button x:Name="PinButton" Content="&#xE718;" FontSize="13"
                            Style="{StaticResource TitleButton}" Click="OnPinClick"
                            ToolTip="Pin: keep open when you click elsewhere (and to drag files in)" />
                    <Button Content="&#x2715;" FontSize="11"
                            Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                </StackPanel>
                <Grid VerticalAlignment="Center" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#C8C8C8" Margin="0,1,8,0" />
                    <TextBlock Grid.Column="1" Text="Voice notes" Foreground="#D8D8D8" FontSize="12" />
                    <TextBlock x:Name="TitleDetail" Grid.Column="2" Foreground="#9A9A9A" FontSize="12"
                               Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Footer: language, Copy all, Clear. -->
        <Border DockPanel.Dock="Bottom" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyAllButton" Content="Copy all" Style="{StaticResource LinkButton}" Click="OnCopyAllClick" />
                    <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource LinkButton}" Click="OnClearClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Language" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center"
                               Margin="2,0,8,0" />
                    <ComboBox x:Name="LanguageBox" FontSize="12" MinWidth="150" Padding="8,3"
                              DisplayMemberPath="Label" SelectionChanged="OnLanguageChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="Cards" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F1F1F" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6"
                                    Margin="10,10,10,0" Padding="12,9,8,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding CopyLabel}" VerticalAlignment="Top"
                                                Style="{StaticResource LinkButton}" Click="OnCopyClick"
                                                x:Name="CopyButton" />
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="{Binding FileName}" Foreground="#9A9A9A" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock x:Name="DetailText" Text="{Binding Detail}" Foreground="#7A7A7A" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Busy: what it's doing, with a bar. -->
                                    <StackPanel x:Name="BusyPanel" Margin="0,8,4,2" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Status}" Foreground="#C8C8C8" FontSize="13" FontStyle="Italic" />
                                        <ProgressBar x:Name="Bar" Height="3" Margin="0,8,0,0" Maximum="1" IsIndeterminate="True"
                                                     Value="{Binding ProgressValue, Mode=OneWay}" Foreground="#FFC828"
                                                     Background="#2E2E2E" BorderThickness="0" MinHeight="3" />
                                    </StackPanel>

                                    <!-- Done: the transcript, editable so a misheard word can be fixed before copying. -->
                                    <TextBox x:Name="TextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="-4,6,0,0" Padding="4,2" FontSize="14" Foreground="#E8E8E8"
                                             Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                             AcceptsReturn="True" MinHeight="0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter TargetName="BusyPanel" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TextBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CopyButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                    <Setter TargetName="Bar" Property="IsIndeterminate" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Queued">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="TextBox" Property="Foreground" Value="#FF7B6B" />
                                    <Setter TargetName="TextBox" Property="IsReadOnly" Value="True" />
                                    <Setter TargetName="CopyButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Nothing yet, or a file being dragged over the window. -->
            <Border x:Name="DropHint" Margin="16" CornerRadius="10" BorderThickness="2" BorderBrush="#3A3A3A"
                    Background="#141414">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                               Foreground="#5A5A5A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropTitle" Text="No voice notes yet" Foreground="#D8D8D8" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock Foreground="#9A9A9A" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="18" MaxWidth="280">
                        In WhatsApp, open a voice note's menu → <Run Foreground="#D8D8D8">Open with</Run> →
                        <Run Foreground="#D8D8D8">Voice Note Transcriber</Run>.
                        <LineBreak />Or copy one (Share → Copy) and press <Run Foreground="#D8D8D8">Ctrl+V</Run> here.
                        <LineBreak />Or drag files here, or
                        <Hyperlink Foreground="#60CDFF" Click="OnOpenClick">open them</Hyperlink>.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
      </DockPanel>
    </Border>
</Window>
