<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to the WinRT clipboard (pasting from the Share window). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (the tray icon); WPF has no tray API of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms share type names; explicit usings avoid ambiguity. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VoiceNoteTranscriber</RootNamespace>
    <AssemblyName>VoiceNoteTranscriber</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (the Windows 11 Fluent theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Source-generated Win32 interop (LibraryImport) needs this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Whisper.net's native libraries are per platform; only x64 is shipped. -->
    <PlatformTarget>x64</PlatformTarget>

    <Version>1.0.0</Version>
    <Product>Voice Note Transcriber</Product>
    <Description>Voice Note Transcriber - read WhatsApp voice notes instead of listening</Description>
    <!-- Shown as the exe's "File description" in Explorer, Task Manager and "Open with". -->
    <AssemblyTitle>Voice Note Transcriber</AssemblyTitle>
  </PropertyGroup>

  <!-- Release publishing: self-contained (nothing to install), a folder with the
       exe and Whisper's native DLLs next to it. Not single-file: the native
       Whisper runtimes would have to be unpacked to a temp folder at startup. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Vulkan runs on any recent GPU with just the normal driver (CUDA would need the
         CUDA toolkit installed); the CPU runtime is the fallback. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- WhatsApp voice notes are Ogg Opus, which Windows can't decode by itself. This is
         just the official native libopus (opus.dll); the managed Concentus decoder
         fails on parts of real WhatsApp notes. -->
    <PackageReference Include="Concentus.Native.NetCore" Version="1.5.2" />
    <!-- Everything else (mp3, m4a, wav, ...) goes through Media Foundation. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
